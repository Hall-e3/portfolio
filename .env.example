# Copy to .env.local for local dev, and set as repository secrets/variables
# for the GitHub Actions build (see README.md).

# Password checked client-side to unlock /admin. This ships inside the
# static bundle — it deters casual visitors, it is not real security.
NEXT_PUBLIC_ADMIN_PASSWORD=

# Only needed for a GitHub *project* page (https://<user>.github.io/<repo>/).
# Set to /<repo-name>. Leave empty for a user/org page (https://<user>.github.io/).
NEXT_PUBLIC_BASE_PATH=
